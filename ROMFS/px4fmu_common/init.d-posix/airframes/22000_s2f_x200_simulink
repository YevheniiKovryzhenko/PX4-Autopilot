#!/bin/sh
#
# @name S2F-X200 - external simulator
# @type Standard VTOL
# @class VTOL
# @maintainer S2F-X200 project
#

. ${R}etc/init.d/airframes/22000_s2f_x200_simulink

# Trajectories in SITL use the launch working directory, not a hardware SD card.
param set-default SMG_TRAJ_DIR 0

# Virtual output order for a MAVLink-connected external dynamics simulator.
# These mappings affect SITL only; hardware routing remains unassigned.
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 105
param set-default PWM_MAIN_FUNC6 201
param set-default PWM_MAIN_FUNC7 202
param set-default PWM_MAIN_FUNC8 203
param set-default PWM_MAIN_FUNC9 204
param set-default PWM_MAIN_FUNC10 205
param set-default PWM_MAIN_FUNC11 206
param set-default PWM_MAIN_FUNC12 207
